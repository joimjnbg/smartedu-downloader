{
  "name": "smartedu-downloader",
  "version": "1.7.0",
  "description": "SmartEdu资源下载器 - 国家中小学智慧教育平台资源下载工具",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node tdd-logic.js && node tdd-downloader.js && node tdd-catalog.js",
    "check:asar": "node scripts/check-asar.js",
    "build:win-x64": "electron-builder --win --x64 && node scripts/check-asar.js",
    "build:win-arm64": "electron-builder --win --arm64 && node scripts/check-asar.js",
    "build:mac-x64": "electron-builder --mac --x64 && node scripts/check-asar.js",
    "build:mac-arm64": "electron-builder --mac --arm64 && node scripts/check-asar.js",
    "build:linux-x64": "electron-builder --linux --x64 && node scripts/check-asar.js",
    "build:linux-arm64": "electron-builder --linux --arm64 && node scripts/check-asar.js",
    "build:all": "electron-builder --win --mac --linux --x64 --arm64 && node scripts/check-asar.js"
  },
  "build": {
    "appId": "com.smartedu.downloader",
    "productName": "SmartEdu下载器",
    "directories": {
      "output": "out"
    },
    "files": [
      "main.js",
      "lib.js",
      "net.js",
      "downloader.js",
      "catalog.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "artifactName": "${productName}-${os}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-${os}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-${os}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "keywords": [
    "smartedu",
    "downloader",
    "education"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  }
}
